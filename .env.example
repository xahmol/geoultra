# GeoUltra: this PC's settings. Copy to .env (gitignored) and fill in
# what differs on your PC; a key left out takes the default named here.
# The Makefile and the scripts (tools/localcfg.py) both read .env. Use
# absolute paths: make does not expand ~.

# ---------------------------------------------------------------------
# Building and running
# ---------------------------------------------------------------------

# VICE 3.10 or later (the Megabyter cartridge needs 3.10): the folder
# with x64sc and c1541 (default: from the PATH)
# VICE_BIN=/opt/vice-3.10/bin

# The Ultimate's IP address and where make deploy puts the cartridge
# (only for make deploy)
# ULTIP1=192.168.1.64
# DEPLOYDIR=/SD/geoultra/

# ---------------------------------------------------------------------
# Optional: the test suites (mainly the developers' own test work)
# ---------------------------------------------------------------------
# They need your own GEOS disk images (never committed), and some an
# Ultimate on the network (ULTIP1 above), Oscar64 or a GeoUTools
# checkout. Building does not need any of this.

# A headless VICE build (no window, no sound) for unattended runs
# (default: VICE_BIN's)
# VICE_HEADLESS_BIN=/opt/vice-3.10-headless/bin

# Oscar64 (the smoke tests; default: oscar64 from the PATH)
# OSCAR64=/opt/oscar64/bin/oscar64

# GeoUTools (some U64 tests and the video scripts; default: next to
# this repository)
# GEOUTOOLS=/home/me/git/GeoUTools

# Your own GEOS disk images (default: private/ in this repository). The
# tests look for these names in it, unless set alone:
#   GEOS_ORACLE       GEOS64-v2.0-unkeyed.d64  (GEOS 2.0 boot disk, 1541)
#   GEOS_ORACLE81     GEOS64.D81               (GEOS 2.0 on a 1581, geoWrite 2.1)
#   GEOS_APPS_DISK    neos-mouse-driver-for-geos.d64
#   GEOS_NATIVE_DISK  ramapps.DNP
#   SYSFONT_DISK, GEOS_FONTS_DISK  GEOS64.D81
#   GEOS_PAINT_IMAGE  mp3-64.d81
# GEOS_DEV=/home/me/geos-disks
# GEOS_ORACLE=/home/me/geos-disks/my-geos.d64

# GeoLudo's disk (tests/apps/geoludo.py), GeoUTools' geoWrite manual
# (tests/print), the idi8b logo for videos (tools/video/edit.py)
# LUDO_DISK=/home/me/git/ludo/GEOS/GeoLudo.d81
# GEOUTOOLS_MANUAL=/home/me/git/GeoUTools/docs/geowrite-manual-en.cvt
# IDI8B_LOGO=/home/me/pictures/idi8b-logo.png
